{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptadynamik.org/schemas/llm-structural/structural-observation.schema.json",
  "title": "D_O v9 primary structural observation",
  "allOf": [{"$ref": "common-definitions.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": [
    "observer", "observer_version", "base_observer",
    "turn_index", "window_index", "absolute_window_index",
    "transport_status", "recurrence_status", "contraction_status",
    "mobility_status", "structural_state", "movement",
    "transport_coherence", "recurrence_persistence", "variation_contraction",
    "diagnostics", "alert_eligible", "transport_deficit",
    "cumulative_transport_deficit", "evidence_window_start",
    "evidence_window_end", "causal", "external_outcome_used",
    "provider_termination_metadata_used"
  ],
  "properties": {
    "artifact_type": {"const": "structural_observation"},
    "observer": {"const": "D_O_v9"},
    "observer_version": {"const": "D_O_v9"},
    "base_observer": {"const": "D_O_v6"},
    "turn_index": {"type": "integer", "minimum": 0},
    "window_index": {"type": "integer", "minimum": 0},
    "absolute_window_index": {"type": "integer", "minimum": 0},
    "transport_status": {
      "enum": ["UNRESOLVED", "INACTIVE", "COHERENT", "PROVISIONAL", "DISRUPTED"]
    },
    "recurrence_status": {
      "enum": ["UNRESOLVED", "INACTIVE", "NON_RECURRENT", "RECURRENT"]
    },
    "contraction_status": {
      "enum": ["UNRESOLVED", "NOT_CONTRACTING", "CONTRACTING"]
    },
    "mobility_status": {
      "enum": [null, "VIABLE", "STAGNANT", "RECURRENT", "CRYSTALLIZING", "CRYSTALLIZED"]
    },
    "structural_state": {
      "enum": [
        "VIABLE", "STAGNANT", "RECURRENT", "CRYSTALLIZING", "CRYSTALLIZED",
        "TRANSPORT_DISRUPTED", "TRANSPORT_UNRESOLVED"
      ]
    },
    "movement": {"type": "number", "minimum": 0},
    "transport_coherence": {
      "type": ["number", "null"], "minimum": 0, "maximum": 1
    },
    "recurrence_persistence": {"type": "number", "minimum": 0, "maximum": 1},
    "variation_contraction": {
      "type": ["number", "null"], "minimum": 0, "maximum": 1
    },
    "diagnostics": {
      "type": "array", "items": {"type": "string"}, "uniqueItems": true
    },
    "alert_eligible": {"type": "boolean"},
    "transport_deficit": {
      "type": ["number", "null"], "minimum": 0
    },
    "cumulative_transport_deficit": {"type": "number", "minimum": 0},
    "evidence_window_start": {"type": "integer", "minimum": 0},
    "evidence_window_end": {"type": "integer", "minimum": 0},
    "causal": {"const": true},
    "external_outcome_used": {"const": false},
    "provider_termination_metadata_used": {"const": false}
  }
}
