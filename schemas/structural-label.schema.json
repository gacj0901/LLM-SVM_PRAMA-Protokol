{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptadynamik.org/schemas/llm-structural/structural-label.schema.json",
  "title": "Secondary deterministic multichannel annotation",
  "allOf": [{"$ref": "common-definitions.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": [
    "label", "label_version", "rule_id", "required_channels",
    "satisfied_conditions", "failed_conditions", "unavailable_conditions",
    "calibration_reference", "evidence_window_start", "evidence_window_end",
    "confidence_status", "annotation_role",
    "structural_observation_reference", "claim_boundary"
  ],
  "properties": {
    "artifact_type": {"const": "structural_label"},
    "label": {
      "enum": [
        "monitor.VIABLE_INTERACTION",
        "monitor.UNRESOLVED_FRICTION",
        "monitor.RECURSIVE_IMITATIVE_ITERATION",
        "monitor.CRYSTALLIZATION_CANDIDATE",
        "monitor.INDETERMINATE"
      ]
    },
    "label_version": {"const": "structural-labels/1.0.0"},
    "rule_id": {"type": "string", "minLength": 1},
    "required_channels": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "satisfied_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "failed_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unavailable_conditions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "calibration_reference": {"type": "string", "minLength": 1},
    "evidence_window_start": {"type": "integer", "minimum": 0},
    "evidence_window_end": {"type": "integer", "minimum": 0},
    "confidence_status": {"enum": ["SUPPORTED", "PARTIALLY_SUPPORTED", "INDETERMINATE"]},
    "annotation_role": {"const": "SECONDARY_INTERPRETIVE"},
    "structural_observation_reference": {
      "$ref": "common-definitions.schema.json#/$defs/sha256"
    },
    "claim_boundary": {
      "type": "object",
      "required": [
        "complete_viability_regime_claimed", "consciousness_claimed",
        "deception_claimed", "interpretive_label_is_ground_truth"
      ],
      "properties": {
        "complete_viability_regime_claimed": {"const": false},
        "consciousness_claimed": {"const": false},
        "deception_claimed": {"const": false},
        "interpretive_label_is_ground_truth": {"const": false}
      }
    }
  }
}
