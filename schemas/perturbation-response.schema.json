{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptadynamik.org/schemas/llm-structural/perturbation-response.schema.json",
  "title": "Perturbation response",
  "allOf": [{"$ref": "common-definitions.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": [
    "perturbation_id", "introduced_at_window", "response_horizon_windows",
    "response_class", "trajectory_change_magnitude", "recovery_detected"
  ],
  "properties": {
    "artifact_type": {"const": "perturbation_response"},
    "perturbation_id": {"type": "string", "minLength": 1},
    "introduced_at_window": {"type": "integer", "minimum": 0},
    "response_horizon_windows": {"type": "integer", "minimum": 1},
    "response_class": {
      "enum": [
        "adaptive_integration", "partial_integration",
        "persistent_nonintegration", "counterfactual_rejection", "indeterminate"
      ]
    },
    "trajectory_change_magnitude": {"type": "number", "minimum": 0},
    "recovery_detected": {"type": "boolean"},
    "recovery_latency_windows": {"type": ["integer", "null"], "minimum": 0}
  }
}
