{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptadynamik.org/schemas/llm-structural/coupling-observation.schema.json",
  "title": "Teacher-forced contextual-support observation",
  "allOf": [{"$ref": "common-definitions.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": [
    "turn_index", "window_index", "token_start", "token_end",
    "self_support", "user_support", "interaction", "support_magnitude",
    "omega_dep", "expected_omega_dep", "self_dependence_excess",
    "filler_variance", "eligible", "expectation_status"
  ],
  "properties": {
    "artifact_type": {"const": "coupling_observation"},
    "turn_index": {"type": "integer", "minimum": 0},
    "window_index": {"type": "integer", "minimum": 0},
    "token_start": {"type": "integer", "minimum": 0},
    "token_end": {"type": "integer", "minimum": 1},
    "self_support": {"type": ["number", "null"]},
    "user_support": {"type": ["number", "null"]},
    "interaction": {"type": ["number", "null"]},
    "support_magnitude": {"type": ["number", "null"], "minimum": 0},
    "omega_dep": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "expected_omega_dep": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "self_dependence_excess": {"type": ["number", "null"], "minimum": -2, "maximum": 2},
    "filler_variance": {"type": ["number", "null"], "minimum": 0},
    "eligible": {"type": "boolean"},
    "expectation_status": {"type": "string"}
  }
}
