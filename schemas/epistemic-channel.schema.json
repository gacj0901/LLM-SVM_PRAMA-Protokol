{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptadynamik.org/schemas/llm-structural/epistemic-channel.schema.json",
  "title": "Paired epistemic-channel observation",
  "allOf": [{"$ref": "common-definitions.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": [
    "task_id", "pair_id", "condition_id", "task_state_sha256",
    "competence_reference", "competence_condition", "effect_vector",
    "competence_preserved", "channel_valid"
  ],
  "properties": {
    "artifact_type": {"const": "epistemic_channel"},
    "task_id": {"type": "string", "minLength": 1},
    "pair_id": {"type": "string", "minLength": 1},
    "condition_id": {"type": "string", "minLength": 1},
    "task_state_sha256": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "competence_reference": {"type": "number"},
    "competence_condition": {"type": "number"},
    "competence_preserved": {"type": "boolean"},
    "channel_valid": {"type": "boolean"},
    "effect_vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_coverage_shift", "verifier_relevant_omission_shift",
        "precision_shift", "calibration_shift", "response_quality_shift"
      ],
      "properties": {
        "evidence_coverage_shift": {"type": "number"},
        "verifier_relevant_omission_shift": {"type": "number"},
        "precision_shift": {"type": "number"},
        "calibration_shift": {"type": "number"},
        "response_quality_shift": {"type": "number"}
      }
    }
  }
}
