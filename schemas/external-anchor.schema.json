{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptadynamik.org/schemas/llm-structural/external-anchor.schema.json",
  "title": "External anchor event",
  "allOf": [{"$ref": "common-definitions.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": [
    "anchor_id", "anchor_type", "introduced_at_window", "anchor_state",
    "severity", "externally_verifiable", "anchor_source_sha256",
    "uptake_detected", "uptake_latency_windows"
  ],
  "properties": {
    "artifact_type": {"const": "external_anchor_event"},
    "anchor_id": {"type": "string", "minLength": 1},
    "anchor_type": {"type": "string", "minLength": 1},
    "introduced_at_window": {"type": "integer", "minimum": 0},
    "anchor_state": {"type": "string"},
    "severity": {"type": "number", "minimum": 0, "maximum": 1},
    "externally_verifiable": {"type": "boolean"},
    "anchor_source_sha256": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "uptake_detected": {"type": "boolean"},
    "uptake_latency_windows": {"type": ["integer", "null"], "minimum": 0}
  }
}
