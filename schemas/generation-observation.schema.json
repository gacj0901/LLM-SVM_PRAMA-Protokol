{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aptadynamik.org/schemas/llm-structural/generation-observation.schema.json",
  "title": "Immutable generation observation",
  "allOf": [{"$ref": "common-definitions.schema.json#/$defs/envelope"}],
  "type": "object",
  "required": [
    "model_id",
    "prompt_sha256",
    "response_sha256",
    "response_time_seconds"
  ],
  "properties": {
    "artifact_type": {"const": "generation_observation"},
    "model_id": {"type": "string", "minLength": 1},
    "prompt_sha256": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "response_sha256": {"$ref": "common-definitions.schema.json#/$defs/sha256"},
    "response_time_seconds": {"type": "number", "minimum": 0},
    "finish_reason": {"type": ["string", "null"]},
    "token_count": {"type": ["integer", "null"], "minimum": 0}
  }
}
